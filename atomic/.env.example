# ---------- Hardhat / deploy (Base Sepolia, chainId 84532) ----------
PRIVATE_KEY=                      # deployer key (testnet only!)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=                # Etherscan API V2 key (works for Base Sepolia; Basescan V1 keys are retired)
ISSUER_ADDRESS=                   # optional: server Pimlico smart-account address (GET /api/issuer)

# ---------- Deployed contracts (printed by scripts/deploy.js) ----------
ATOMIC_MINT_ADDRESS=
SBT_ADDRESS=
TBA_FACTORY_ADDRESS=

# ---------- Server ----------
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173      # frontend origin, also the WebAuthn origin
WEBAUTHN_RP_ID=localhost                  # must equal the frontend hostname
WEBAUTHN_RP_NAME=AWallet Demo
DEMO_INVITE_CODE=                         # required to register a passkey (demo gate)
ADMIN_TOKEN=                              # protects POST /api/devices/enroll
ATOMIC_MINT_TIER=3                        # 2 = Pico W or passkey, 3 = passkey only

# ---------- Pimlico (ERC-4337 bundler + paymaster) ----------
PIMLICO_API_KEY=
ISSUER_PRIVATE_KEY=                       # owner key of the issuer smart account (testnet only!)
SPONSORSHIP_POLICY_ID=                    # optional Pimlico sponsorship policy

# ---------- Curvegrid MultiBaas ----------
MULTIBAAS_BASE_URL=                       # e.g. https://xxxx.multibaas.com
MULTIBAAS_API_KEY=
